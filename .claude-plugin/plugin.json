{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "forge-methodology",
  "displayName": "Forja / Forge",
  "version": "1.0.3",
  "description": "9-step human↔AI methodology: an enumerated external reference feeds an Acceptance Matrix (one req-id per capability), and a hook blocks gh pr create while any in-scope row lacks real evidence or an independent verifier. Domain-agnostic.",
  "author": {
    "name": "David García Gordo",
    "url": "https://github.com/davidgarciagordo"
  },
  "homepage": "https://github.com/davidgarciagordo/forge-methodology",
  "repository": "https://github.com/davidgarciagordo/forge-methodology",
  "license": "MIT",
  "keywords": [
    "methodology",
    "spec",
    "grill",
    "planning",
    "verification",
    "forge"
  ],
  "skills": [
    "./",
    "./skills/grill-me",
    "./skills/grill-with-docs"
  ],
  "commands": "./commands",
  "agents": [
    "./agents/completeness-critic.md",
    "./agents/independent-verifier.md",
    "./agents/reference-decomposer.md",
    "./agents/visual-fidelity-checker.md"
  ]
}
